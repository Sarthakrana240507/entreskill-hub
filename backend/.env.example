# ============================================================================
# EntreSkill Hub — Backend Environment Variables
# Copy this file to .env and fill in real values. NEVER commit .env itself.
# ============================================================================

# Server
NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000

# Database (PostgreSQL connection string)
# Local:   postgresql://USER:PASSWORD@localhost:5432/entreskill_hub
# Cloud (Neon/Supabase/Railway): use the connection string they provide
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/entreskill_hub?schema=public"

# JWT
JWT_ACCESS_SECRET=change_this_to_a_long_random_string_min_32_chars
JWT_REFRESH_SECRET=change_this_to_a_different_long_random_string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# Cloud Object Storage (e.g. Cloudinary / AWS S3 / Supabase Storage)
# Used for mentor avatars, resource thumbnails, etc.
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
